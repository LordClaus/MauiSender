<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSender.Pages.SenderPage"
             Title="SenderPage">
    <Grid RowDefinitions="Auto,*">
        <!-- Top control bar -->
        <Grid Padding="8" ColumnDefinitions="*,Auto,100,100,100,Auto,Auto,Auto" BackgroundColor="{DynamicResource SystemColorControlBackground}">
            <Picker Title="Шаблон" ItemsSource="{Binding Templates}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedTemplate}" />
            <Picker Grid.Column="1" Title="Режим" ItemsSource="{Binding TemplateModes}" SelectedItem="{Binding TemplateMode}" />

            <StackLayout Grid.Column="2">
                <Label FontSize="12" Text="Інтервал (сек)" />
                <Entry Text="{Binding BaseIntervalSec}" Keyboard="Numeric" />
            </StackLayout>

            <StackLayout Grid.Column="3">
                <Label FontSize="12" Text="Частина (сек)" />
                <Entry Text="{Binding PartIntervalSec}" Keyboard="Numeric" />
            </StackLayout>

            <StackLayout Grid.Column="4">
                <Label FontSize="12" Text="Jitter (%)" />
                <Entry Text="{Binding JitterPct}" Keyboard="Numeric" />
            </StackLayout>

            <Button Grid.Column="5" Text="Старт" Command="{Binding StartCommand}" />
            <Button Grid.Column="6" Text="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" />
            <Button Grid.Column="7" Text="Стоп" Command="{Binding StopCommand}" />
        </Grid>

        <!-- WebView (workspace) -->
        <WebView x:Name="ChatWeb" Grid.Row="1" Source="https://goldenbride.net/chat#!CHAT;" Navigated="OnChatNavigated" />
    </Grid>
</ContentPage>