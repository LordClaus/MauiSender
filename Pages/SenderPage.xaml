<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSender.Pages.SenderPage"
             Title="SenderPage">
    <Grid RowDefinitions="Auto,*">
        <!-- Наша верхня панель (спрощений варіант) -->
        <Grid BackgroundColor="#1f2630" Padding="8" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Label Text="Шаблони" TextColor="White" Margin="0,0,12,0" VerticalOptions="Center" />
            <Picker x:Name="TemplatePicker" WidthRequest="220" />
            <Label Text="Інтервал (сек)" TextColor="White" Margin="12,0,8,0" VerticalOptions="Center" />
            <Entry x:Name="IntervalEntry" WidthRequest="80" Text="45" Keyboard="Numeric" />
            <Button Text="Start" Clicked="OnStartClicked" Margin="12,0,0,0" />
        </Grid>

        <!-- WebView з чатом -->
        <WebView x:Name="ChatWeb" Grid.Row="1" Source="https://goldenbride.net/chat#!CHAT;" />
    </Grid>
</ContentPage>