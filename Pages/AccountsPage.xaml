<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSender.Pages.AccountsPage"
             Title="AccountsPage">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12">
        <VerticalStackLayout Spacing="8">
            <Label Text="Список акаунтів (зберігаються у accounts.json)" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Логін (email або ID)" Text="{Binding NewLogin}" />
                <Entry Grid.Column="1" Placeholder="Пароль" IsPassword="True" WidthRequest="220" Text="{Binding NewPassword}" />
                <Button Grid.Column="2" Text="Додати" Command="{Binding AddAccountCommand}" />
                <Button Grid.Column="3" Text="Зберегти" Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        SelectionMode="Single"
                        ItemsSource="{Binding Accounts}"
                        SelectedItem="{Binding SelectedAccount}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Login}" FontAttributes="Bold" />
                            <Label Text="{Binding MaskedPassword}" FontAttributes="Italic" FontSize="12" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Видалити" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountsViewModel}}, Path=RemoveAccountCommand}" CommandParameter="{Binding .}" />
                        <Button Grid.Column="2" Text="Відкрити чат" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountsViewModel}}, Path=OpenChatCommand}" CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" StrokeThickness="1" Stroke="#ddd" Padding="8" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout>
                <Label Text="Вбудований перегляд (https://goldenbride.net) для реєстрації/перевірки" />
                <WebView HeightRequest="320" Source="https://goldenbride.net" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>