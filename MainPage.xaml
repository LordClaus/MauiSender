<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSender.MainPage"
             xmlns:vm="clr-namespace:MauiSender.ViewModels">
    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" Padding="8" RowSpacing="8">
        <!-- TopBar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" Padding="8" BackgroundColor="{AppThemeBinding Light=#f3f4f6, Dark=#1f2937}">
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Picker Title="Шаблони" ItemsSource="{Binding TemplateNames}" SelectedItem="{Binding SelectedTemplateName}"/>
                <Picker Title="Режим" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="Інтервал (сек)" FontSize="10"/>
                <Entry WidthRequest="80" Keyboard="Numeric" Text="{Binding BaseIntervalSec}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="4">
                <Label Text="Part delay (сек)" FontSize="10"/>
                <Entry WidthRequest="80" Keyboard="Numeric" Text="{Binding PartIntervalSec}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="4">
                <Label Text="Jitter (%)" FontSize="10"/>
                <Entry WidthRequest="60" Keyboard="Numeric" Text="{Binding JitterPct}"/>
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center">
                <Button Text="Start" Command="{Binding StartCommand}"/>
                <Button Text="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}"/>
                <Button Text="Stop" Command="{Binding StopCommand}"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="5" Spacing="6" VerticalOptions="Center">
                <Button Text="Шаблони" Command="{Binding ManageTemplatesCommand}"/>
                <Button Text="Blacklist" Command="{Binding ManageBlacklistCommand}"/>
                <Button Text="Експорт" Command="{Binding ExportLogsCommand}"/>
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Column="6" Spacing="2" HorizontalOptions="End">
                <Label Text="{Binding CountersText}" FontAttributes="Bold"/>
                <Label Text="{Binding ActiveTemplateText}" FontSize="12"/>
                <Label Text="{Binding NextRecipientText}" FontSize="12"/>
            </VerticalStackLayout>
        </Grid>

        <!-- WebView -->
        <WebView Grid.Row="1"
             x:Name="GoldenWeb"
             Source="https://goldenbride.net"
             Navigated="WebView_Navigated" />
    </Grid>
</ContentPage>
