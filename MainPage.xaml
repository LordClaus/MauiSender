<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiSender.MainPage"
             xmlns:vm="clr-namespace:MauiSender.ViewModels">
    <Grid RowDefinitions="Auto,*">
        <!-- TopBar -->
        <Grid Grid.Row="0" Padding="8" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Label Text="Mode:" VerticalOptions="Center" />
            <Picker x:Name="PickerMode" Grid.Column="1" WidthRequest="140">
                <Picker.Items>
                    <x:String>Random</x:String>
                    <x:String>RoundRobin</x:String>
                </Picker.Items>
            </Picker>

            <Label Grid.Column="2" Text="Base Interval (sec):" VerticalOptions="Center" />
            <Entry x:Name="EntryBaseInterval" Grid.Column="3" WidthRequest="80" Keyboard="Numeric" Text="30" />

            <Label Grid.Column="4" Text="Part Delay (sec):" VerticalOptions="Center" />
            <Entry x:Name="EntryPartDelay" Grid.Column="5" WidthRequest="80" Keyboard="Numeric" Text="8" />

            <Button x:Name="BtnStart" Grid.Column="6" Text="Start" Clicked="OnStartClicked" />
            <Button x:Name="BtnStop"  Grid.Column="7" Text="Stop"  Clicked="OnStopClicked"  IsEnabled="False" />
            <Button x:Name="BtnReload" Grid.Column="8" Text="Reload templates" Clicked="OnReloadClicked" />
        </Grid>

        <!-- Другий ряд: керування шаблонами -->
        <Grid Grid.Row="0" Margin="8,48,8,0" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
            <Button Text="Add template" Clicked="OnAddTemplateClicked" />
            <Button Grid.Column="1" Text="Edit template" Clicked="OnEditTemplateClicked" />
            <Button Grid.Column="2" Text="Delete template" Clicked="OnDeleteTemplateClicked" />
        </Grid>

        <!-- Робоче вікно: WebView -->
        <WebView x:Name="MyWebView" Grid.Row="1"
                 Source="https://goldenbride.net"
                 Navigating="Web_Navigating"
                 Navigated="Web_Navigated" />
    </Grid>
</ContentPage>
